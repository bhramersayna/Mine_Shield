# ==============================================================================
# MineShield — Environment Configuration Template
# Mineral Transportation Record Reconciliation & Compliance Audit Platform
# ==============================================================================

# Server Environment & Port Configuration
NODE_ENV=development
PORT=5000

# Security: JWT Token Configuration
# Generate a cryptographically secure 256-bit secret for production (e.g., openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_for_production
JWT_EXPIRES_IN=12h

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# Options: 'sqlite' (local ACID engine) | 'azuresql' (cloud enterprise database)
# ------------------------------------------------------------------------------
DATABASE_PROVIDER=sqlite
SQLITE_PATH=./mineshield.db

# Azure SQL Database Configuration (Required only when DATABASE_PROVIDER=azuresql)
AZURE_SQL_SERVER=your-azure-sql-server.database.windows.net
AZURE_SQL_DATABASE=mineshield-db
AZURE_SQL_USER=mineshield_admin
AZURE_SQL_PASSWORD=your_strong_azure_sql_password

# ------------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION
# Options: 'local' (local disk storage) | 'azureblob' (cloud object storage)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads

# Azure Blob Storage Configuration (Required only when STORAGE_PROVIDER=azureblob)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=mineshield-evidence

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
