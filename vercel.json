{
  "version": 2,
  "installCommand": "npm install && npm install --prefix mineshield-frontend",
  "buildCommand": "npm run build --prefix mineshield-frontend",
  "outputDirectory": "mineshield-frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
